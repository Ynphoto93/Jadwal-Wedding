= '#2563eb'; btnCancel.style.display = 'none'; } function editJob(e, index) { e.stopPropagation(); editingIndex = index; const job = jobs[index]; // Isi form dengan data yang dipilih document.getElementById('month').value = job.month; document.getElementById('year').value = job.year; document.getElementById('dateText').value = job.dateText; document.getElementById('clientName').value = job.clientName; document.getElementById('location').value = job.location; document.getElementById('totalPrice').value = job.totalPrice || ''; document.getElementById('dpAmount').value = job.dpAmount || ''; document.getElementById('package').value = job.package || ''; document.getElementById('notes').value = job.notes || ''; // Ubah tombol submit menjadi tombol simpan btnSubmit.textContent = '💾 Simpan Perubahan Job'; btnSubmit.style.backgroundColor = '#f59e0b'; btnCancel.style.display = 'block'; // Scroll ke paling atas untuk mengedit window.scrollTo({ top: 0, behavior: 'smooth' }); } function renderJobs(dataToRender) { jobContainer.innerHTML = ''; if (dataToRender.length === 0) { jobContainer.innerHTML = '<div class="empty-state">Belum ada jadwal tersimpan. Silakan isi form di atas.</div>'; return; } const sortedJobs = [...dataToRender].sort((a, b) => { if (parseInt(a.year) !== parseInt(b.year)) { return parseInt(a.year) - parseInt(b.year); } if (parseInt(a.month) !== parseInt(b.month)) { return parseInt(a.month) - parseInt(b.month); } return extractFirstDay(a.dateText) - extractFirstDay(b.dateText); }); const groupedJobs = {}; sortedJobs.forEach(job => { const headerKey = `${monthNames[parseInt(job.month) - 1]} ${job.year}`; if (!groupedJobs[headerKey]) { groupedJobs[headerKey] = []; } groupedJobs[headerKey].push(job); }); Object.keys(groupedJobs).forEach(monthYearHeader => { const monthGroup = document.createElement('div'); monthGroup.className = 'month-group'; const monthJobs = groupedJobs[monthYearHeader]; monthGroup.innerHTML = ` <div class="month-header"> <span>📅 ${monthYearHeader}</span> <span class="count-badge">${monthJobs.length} Job</span> </div> <div class="job-list"></div> `; const jobList = monthGroup.querySelector('.job-list'); monthJobs.forEach(job => { const indexInMainArray = jobs.indexOf(job); const card = document.createElement('div'); const totalVal = parseRupiahToNumber(job.totalPrice); const dpVal = parseRupiahToNumber(job.dpAmount); const remainingVal = totalVal - dpVal; const status = getPaymentStatus(totalVal, dpVal); const displayTotal = job.totalPrice ? job.totalPrice : 'Rp0'; const displayDp = job.dpAmount ? job.dpAmount : 'Rp0'; const displaySisa = formatNumberToRupiah(remainingVal < 0 ? 0 : remainingVal); const isCompleted = job.isCompleted || false; const cardClass = isCompleted ? 'job-card completed' : `job-card ${status.class}`; const badgeHtml = isCompleted ? `<span class="badge badge-completed">✅ SELESAI</span>` : `<span class="badge ${status.badge}">${status.text}</span>`; const toggleBtnHtml = isCompleted ? `<button class="btn-action btn-undo" onclick="toggleCompleteJob(event, ${indexInMainArray})">↩️ Batal Selesai</button>` : `<button class="btn-action btn-complete" onclick="toggleCompleteJob(event, ${indexInMainArray})">✅ Job Selesai</button>`; card.className = cardClass; card.innerHTML = ` <div class="card-summary" onclick="toggleCard(this.parentElement)"> <div class="summary-left"> <span class="date-badge">Tgl ${job.dateText}</span> <span class="client-name-text">💍 ${job.clientName}</span> </div> <div class="summary-right"> ${badgeHtml} <span class="arrow-icon">▼</span> </div> </div> <div class="card-details-body"> <div class="job-details-info"> <p><strong>📍 Lokasi:</strong> ${job.location}</p> <p><strong>📦 Paket:</strong> ${job.package || '-'}</p> </div> <div class="payment-summary"> <div> <span class="label">Total Biaya:</span> <span class="value">${displayTotal}</span> </div> <div> <span class="label">Sudah Dibayar:</span> <span class="value">${displayDp}</span> </div> <div> <span class="label">Sisa Pembayaran:</span> <span class="value sisa">${displaySisa}</span> </div> </div> ${job.notes ? `<div class="notes-box"><strong>📝 Catatan:</strong><br>${job.notes}</div>` : ''} <div class="card-actions"> <button class="btn-action btn-edit" onclick="editJob(event, ${indexInMainArray})">✏️ Edit Job</button> ${toggleBtnHtml} <button class="btn-action btn-delete" onclick="deleteJob(event, ${indexInMainArray})">🗑️ Hapus Job</button> </div> </div> `; jobList.appendChild(card); }); jobContainer.appendChild(monthGroup); }); } jobForm.addEventListener('submit', (e) => { e.preventDefault(); const jobData = { month: document.getElementById('month').value, year: document.getElementById('year').value, dateText: document.getElementById('dateText').value, clientName: document.getElementById('clientName').value, location: document.getElementById('location').value, package: document.getElementById('package').value, totalPrice: document.getElementById('totalPrice').value, dpAmount: document.getElementById('dpAmount').value, notes: document.getElementById('notes').value, isCompleted: editingIndex !== null ? jobs[editingIndex].isCompleted : false }; if (editingIndex !== null) { // Mode Update / Edit jobs[editingIndex] = jobData; } else { // Mode Tambah Baru jobs.push(jobData); } saveData(); resetFormState(); }); function toggleCompleteJob(e, index) { e.stopPropagation(); jobs[index].isCompleted = !jobs[index].isCompleted; saveData(); } function deleteJob(e, index) { e.stopPropagation(); if (confirm('Apakah Anda yakin ingin menghapus jadwal ini?')) { if (editingIndex === index) resetFormState(); jobs.splice(index, 1); saveData(); } } function filterJobs() { const keyword = searchInput.value.toLowerCase(); const filtered = jobs.filter(job => job.clientName.toLowerCase().includes(keyword) || job.location.toLowerCase().includes(keyword) || job.dateText.toLowerCase().includes(keyword) ); renderJobs(filtered); } renderJobs(jobs); 
